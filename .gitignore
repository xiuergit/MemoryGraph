# 运行时记忆数据（保留目录结构）
data/photos/*
!data/photos/.gitkeep
data/memory/*
!data/memory/.gitkeep
data/.trash/
data/.geocode_cache.json
data/.weather_cache.json
data/.memory_desk_port
