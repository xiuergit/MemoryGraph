data/ask_checklist.json
data/ingest_registry.json
data/describe_registry.json
data/story_upsert_registry.json
data/asr_glossary.json
data/cache/**
data/*.db

# DeepSeek 账号导出（手机号 / OAuth，不进 git）
deepseek_data-*/user.json

# 人脸库（参考照与索引不进 git）
data/faces/**/*
!data/faces/README.md
!data/faces/registry.example.json
!data/faces/baby/.gitkeep
data/faces/index.json
data/faces/registry.json

