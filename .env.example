# 高德 Web 服务 API Key（逆地理编码：坐标 → 中文地址）
# 申请：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建 Key（Web 服务）
AMAP_KEY=3614ed14a5b3e0942bca7a96ab762ffa

# Ollama 本地视觉模型（场景 / 物体 / 动作 / tags 等）
# 回家后在终端执行 ollama list 查看已安装模型名，改下面这一行即可
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_VISION_ENABLED=true
OLLAMA_TIMEOUT=180

# Agent 问答用的文本模型（ollama list 里任选一个 chat 模型）
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CHAT_ENABLED=true

# 剪纸台桥接（Desk「送到剪纸排版」）：候选图写入 原图/_mg_*，不共享全库
# PAPER_CUT_ROOT=/Users/you/Documents/剪纸
# PAPER_CUT_STUDIO_URL=http://127.0.0.1:5273

# 人脸识别匹配阈值（0~1，越高越严格）
FACE_MATCH_THRESHOLD=0.45
# 检测置信度下限；过低易把菜/纹理/阴影误判为人脸（与入库阈值对齐）
FACE_DET_SCORE_MIN=0.70
# 参考照入库更严（前端也会按此禁用「加入人脸库」）
FACE_ENROLL_DET_SCORE_MIN=0.70
FACE_ENROLL_MIN_SIDE=80

# InsightFace 模型（buffalo_s 小且下载快；要更准可改 buffalo_l）
INSIGHTFACE_MODEL=buffalo_s
# INSIGHTFACE_ROOT=/Users/you/.insightface/models

# CLIP 衣着兜底（脸不清时比对当天穿搭）
CLIP_ENABLED=true
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
# 国内首次下载 CLIP 慢/超时时：
# HF_ENDPOINT=https://hf-mirror.com   （项目 config 已默认此镜像）
# 或手动下载：bash tools/download_clip.sh，再设 CLIP_PRETRAINED=.../open_clip_model.safetensors
# 暂时跳过：CLIP_ENABLED=false
OUTFIT_MATCH_THRESHOLD=0.82
OUTFIT_MAX_CONFIDENCE=0.72

# 视频字幕 ASR（video2json --backfill transcript）
# 依赖：brew install ffmpeg
# Python 3.14 安装（避开 PyAV）：
#   pip install faster-whisper --no-deps
#   pip install "ctranslate2>=4.0" huggingface_hub tokenizers
# 模型下载：国内默认 HF_ENDPOINT=https://hf-mirror.com，并关闭 Xet（防 401）
# HF_HUB_DISABLE_XET=1
ASR_ENABLED=true
# 模型大小：tiny < base < small < medium < large-v3（越大越准、越慢、越吃内存）
# 中文童声/嘈杂建议至少 small；要明显更好用 medium（约 1.5GB 级下载）
ASR_MODEL=medium
ASR_LANGUAGE=zh
# 童声/喇叭场景 VAD 易截断半句，默认 false
ASR_VAD_FILTER=false
ASR_BEAM_SIZE=5
ASR_INITIAL_PROMPT=以下是普通话。常见人名：糖豆老师、面面。
# 专名纠错：复制 data/asr_glossary.example.json → data/asr_glossary.json 后可改
# 短于此秒数跳过（Live Photo 等）
ASR_MIN_DURATION_S=3
