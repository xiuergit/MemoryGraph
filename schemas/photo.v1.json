{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorygraph.local/schemas/photo.v1.json",
  "title": "MemoryGraph Photo Memory",
  "description": "单张照片的结构化记忆单元。与 video.v1 / audio.v1 分协议并存；Live Photo 用 related_ids 与成对 video 互链，不单开协议。",
  "type": "object",
  "required": [
    "schema_version",
    "photo_id",
    "timestamp",
    "device_id",
    "people",
    "scene",
    "location",
    "objects",
    "actions",
    "emotion",
    "tags",
    "quality",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1", "1.2", "1.3"]
    },
    "photo_id": {
      "type": "string",
      "description": "记忆 id（历史：相对 photos/ 路径 stem）。须与 video_id / audio_id 全库不冲突；JSON 落盘为 data/memory/{photo_id}.json"
    },
    "timestamp": {
      "type": "string",
      "description": "拍摄时间 ISO 8601；无 EXIF 则为空字符串"
    },
    "device_id": {
      "type": "string",
      "description": "来源设备标识，如 iphone / mac；未知可为空字符串"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "type": "number" },
          "role": { "type": "string" },
          "match_method": {
            "type": "string",
            "enum": ["face", "outfit"],
            "description": "face=人脸识别，outfit=衣着兜底"
          },
          "age_at_photo": {
            "type": "object",
            "required": ["years", "months", "days", "total_days", "label"],
            "properties": {
              "years": { "type": "integer", "minimum": 0 },
              "months": { "type": "integer", "minimum": 0 },
              "days": { "type": "integer", "minimum": 0 },
              "total_days": { "type": "integer", "minimum": 0 },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "scene": { "type": "string" },
    "location": {
      "type": "string",
      "description": "可读地名，如 古猗园；由逆地理编码 + 同日归一得出"
    },
    "location_coords": {
      "type": "string",
      "description": "EXIF GPS 原始坐标，格式 '纬度,经度'；无 GPS 则为空字符串"
    },
    "location_admin": {
      "type": "object",
      "description": "逆地理行政区划与完整地址；无 GPS 时各字段为空字符串",
      "properties": {
        "province": { "type": "string", "description": "省，如 上海市、江苏省" },
        "city": { "type": "string", "description": "市" },
        "district": { "type": "string", "description": "区/县" },
        "formatted_address": { "type": "string", "description": "高德 formatted_address 原文" }
      },
      "required": ["province", "city", "district", "formatted_address"],
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "emotion": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality": {
      "type": "object",
      "required": ["blur", "face_detected"],
      "properties": {
        "blur": { "type": "boolean" },
        "face_detected": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "width", "height"],
      "properties": {
        "path": { "type": "string" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "manual_edit": {
      "type": "boolean",
      "description": "兼容字段：任一 manual_* 为 true 时可同步为 true；跳过逻辑以分项为准"
    },
    "manual_location": {
      "type": "boolean",
      "description": "手改地址；regeocode / 地址归一跳过"
    },
    "manual_people": {
      "type": "boolean",
      "description": "手改人物；faces backfill 跳过"
    },
    "manual_vision": {
      "type": "boolean",
      "description": "手改场景/物体等；vision backfill 跳过"
    },
    "related_ids": {
      "type": "array",
      "description": "1.3+ 可选。与其它记忆条目关联。Live Photo：与成对 video 互链，relation=live_photo；不单开 livephoto 协议",
      "items": {
        "type": "object",
        "required": ["id", "media_type", "relation"],
        "properties": {
          "id": {
            "type": "string",
            "description": "对方记忆 id（photo_id / video_id / audio_id）"
          },
          "media_type": {
            "type": "string",
            "enum": ["photo", "video", "audio"]
          },
          "relation": {
            "type": "string",
            "description": "关系类型，如 live_photo、same_moment、derived"
          }
        },
        "additionalProperties": false
      }
    },
    "weather": {
      "type": "object",
      "description": "拍摄日当地天气（日粒度，Open-Meteo Historical）；无时间或 GPS 时可省略",
      "properties": {
        "date": {
          "type": "string",
          "description": "当地日历日 YYYY-MM-DD"
        },
        "code": {
          "type": "integer",
          "description": "WMO weather interpretation code"
        },
        "condition": {
          "type": "string",
          "description": "中文天气简述，如 晴、小雨"
        },
        "temp_max_c": { "type": ["number", "null"] },
        "temp_min_c": { "type": ["number", "null"] },
        "temp_mean_c": { "type": ["number", "null"] },
        "precipitation_mm": { "type": ["number", "null"] },
        "source": {
          "type": "string",
          "description": "数据来源，如 open-meteo"
        },
        "timezone": {
          "type": "string",
          "description": "解释 timestamp 日历日所用时区，默认 Asia/Shanghai"
        }
      },
      "required": [
        "date",
        "code",
        "condition",
        "temp_max_c",
        "temp_min_c",
        "temp_mean_c",
        "precipitation_mm",
        "source",
        "timezone"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
